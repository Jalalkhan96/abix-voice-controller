# ABIX — Voice-Controlled AI Desktop Agent
# Environment Configuration

# Service URLs (Docker services)
STT_SERVICE_URL=http://localhost:8001
TTS_SERVICE_URL=http://localhost:8002
NLU_SERVICE_URL=http://localhost:8003

# Agent Settings
WAKE_WORD_PHRASE=hi abix
LISTEN_DURATION=10
AUDIO_SAMPLE_RATE=16000

# UI Settings
WEBSOCKET_PORT=8765

# Safety
CONFIRMATION_TIMEOUT=15

# Optional: Picovoice access key (if using Porcupine wake word)
# PICOVOICE_ACCESS_KEY=

# Optional: GPU acceleration for STT
# NVIDIA_VISIBLE_DEVICES=all
